Reg.on('npc_hired', (npc) => {
  npc.fatigue = 0; // Усталость (0-100)
  npc.socialNeed = 0; // Потребность в общении
  npc.stuckCount = 0;
  npc.lastX = 0;
  npc.lastY = 0;
});

Reg.on("npc_tick", (npc, state) => {
    if (npc.isCaravanTrader) { npc.task = { type: "idle", path: [] }; return true; }
  if (!npc.inv) npc.inv = { ore: 0 };
  if (!npc.states) npc.states = {};
  if (!npc.emo) npc.emo = { stress: 0, joy: 20, fear: 0, drunk: 0, anger: 0 };
  if (!npc.task) npc.task = { type: 'idle', path: [] };
  if (npc.fatigue === undefined) npc.fatigue = 0;
  if (npc.socialNeed === undefined) npc.socialNeed = 0;
  if (npc.faithNeed === undefined) npc.faithNeed = 0;
  npc.faithNeed = Math.min(100, npc.faithNeed + 0.1); // Вера растет медленно

  if (npc.states['insane']) {
    // Безумный дварф бьется головой, но у него есть шанс выжить
    if (Math.random() < 0.02) {
      npc.hp -= 1;
      Reg.log(`${npc.name} бьется головой о стену в приступе безумия.`, 'death');
    }
    
    // Стресс постепенно падает, чтобы он мог прийти в себя
    npc.emo.stress = Math.max(0, npc.emo.stress - 4);
    
    // Если стресс упал ниже 50, он выходит из безумия
    if (npc.emo.stress < 50) {
      delete npc.states['insane'];
      Reg.log(`${npc.name} приходит в себя. Безумие отступает.`, 'sys');
    }
    
    if (npc.hp <= 0) {
      killNpc(npc, 'умер от безумия');
    }
    return true;
  }

  // ЛОГИКА СНА: Если он спит, он восстанавливает силы постепенно
  const hasMonsterNearby = findAdjacentMonster(npc.x, npc.y);
  if (npc.task.type === 'rest' && !hasMonsterNearby) {
    npc.fatigue = Math.max(0, npc.fatigue - 1.5); 
    npc.hp = Math.min(npc.maxHp, npc.hp + 0.5);   
    if (npc.fatigue <= 0) {
      npc.task = { type: 'idle', path: [] }; 
      Reg.log(`${npc.name} просыпается.`, 'sys'); if (npc.memory) Reg.addThought(npc, 'woke_up');
    }
    return true; 
  }
 

  // АНТИ-ЗАВИСАНИЕ: Если дварф застрял на одном месте или в одной задаче > 50 тиков, сбрасываем
  if (!npc._lastPos) npc._lastPos = {x: npc.x, y: npc.y, taskType: npc.task.type};
  if (npc._lastPos.x === npc.x && npc._lastPos.y === npc.y && npc._lastPos.taskType === npc.task.type) {
      npc._stuckTimer = (npc._stuckTimer || 0) + 1;
      if (npc._stuckTimer > 50) {
          npc.task = { type: 'idle', path: [] };
          npc._stuckTimer = 0;
          npc._lastPos = {x: npc.x, y: npc.y, taskType: 'idle'};
      }
  } else {
      npc._lastPos = {x: npc.x, y: npc.y, taskType: npc.task.type};
      npc._stuckTimer = 0;
  }

  // ТОРГОВЕЦ НЕ ДОЛЖЕН РАБОТАТЬ И ПИТЬ ЭЛЬ (только торговать)
  if (npc.isCaravanTrader) {
      if (npc.task && npc.task.type !== 'idle') npc.task = { type: 'idle', path: [] };
      return true; // Блокируем весь остальной ИИ для торговца
  }

  // АНТИЗАСТРЕВАНИЕ: Если он не двигался 5 тиков и не копает, даем пинка
  if (npc.x === npc.lastX && npc.y === npc.lastY && npc.task.type !== 'dig') {
    npc.stuckCount = (npc.stuckCount || 0) + 1;
    if (npc.stuckCount > 5) {
      npc.task = { type: 'dig', path: [] }; // Принудительно идем копать
      npc.stuckCount = 0;
    }
  } else {
    npc.stuckCount = 0;
  }
  npc.lastX = npc.x;
  npc.lastY = npc.y;

  if (npc.task.type === 'idle' || npc.task.type === 'wander') {
    npc.idleTime = (npc.idleTime || 0) + 1;
    const _pc = (typeof getCell === 'function') ? getCell(npc.x, npc.y) : null;
    const _hi = _pc && _pc.items && _pc.items.length > 0;
    if (_hi) {
      npc._pickupDelay = (npc._pickupDelay || 0) + 1;
      if (npc._pickupDelay >= 30) { npc._pickupDelay = 0; npc.idleTime = 0; }
    } else if (npc.idleTime > 10) {
      npc._pickupDelay = 0;
      npc.task = { type: 'dig', path: [] };
      npc.idleTime = 0;
    }
  } else {
    npc.idleTime = 0;
    npc._pickupDelay = 0;
  }

  // Рост усталости и социальной потребности
  npc.fatigue = Math.min(100, npc.fatigue + 0.5);
  npc.socialNeed = Math.min(100, npc.socialNeed + 0.05);
  npc.thirst = Math.min(100, (npc.thirst || 0) + 0.2);
  if (npc.thirst >= 100) { npc.hp -= 2; if (npc.hp <= 0) { killNpc(npc, "умер от жажды"); return true; } }
  
  // РОСТ ГОЛОДА (чтобы не перебивался core.js)
  npc.hunger = Math.min(100, (npc.hunger || 0) + 0.15);
  if (npc.hunger >= 100) { npc.hp -= 5; if (npc.hp <= 0) { killNpc(npc, "умер от голода"); return true; } }
  // Голод тикает в core.js, здесь мы его не трогаем, чтобы не было двойного роста (NaN)

  const hasMonster = findAdjacentMonster(npc.x, npc.y);

  if (npc.task.type === 'fight' && !hasMonster) {
    npc.task = { type: 'idle', path: [] };
  }

  if (npc.task.type.startsWith('go_to_') && npc.task.path && npc.task.path.length > 0) {
    // Скорость = базовая (от брони) × штраф от травм (body_system + system_injuries)
    const _effSpeed = (npc.speed !== undefined ? npc.speed : 1.0) * (npc.bodySpeedPenalty || 1.0);
    if (Math.random() > _effSpeed) return true;

    const nextStep = npc.task.path.shift();
    // ПРОХОДИМ СКВОЗЬ ДРУГИХ
    npc.x = nextStep.x; 
    npc.y = nextStep.y;
    return true; 
  }

  let adjBarrel = null;
  for (const [dx, dy] of [[0,1],[0,-1],[1,0],[-1,0]]) {
    const c = getCell(npc.x + dx, npc.y + dy);
    if (c && c.type === 'beer_tap') adjBarrel = { x: npc.x + dx, y: npc.y + dy };
  }

  let actions = [];
  if (hasMonster) actions.push({ type: 'fight', weight: 1000 });
  // Считаем реальную руду в рюкзаке
  let realOreCount = 0;
  if (npc.inventory) {
      realOreCount = npc.inventory.filter(i => i.tags && i.tags.includes('iron_ore')).length;
  }
  if (realOreCount >= 10) actions.push({ type: 'deposit', weight: 500 });
  
  // МОЛИТВА: Если вера высокая, дварф хочет помолиться
  if (npc.faithNeed > 50) {
      actions.push({ type: 'pray', weight: npc.faithNeed * 2 });
  }
  
  // КРАФТ: Если у дварфа есть руда (но меньше 10, чтобы не нести на склад), и он у наковальни
  let nearAnvil = false;
  for (let dx = -2; dx <= 2; dx++) {
      for (let dy = -2; dy <= 2; dy++) {
          const c = getCell(npc.x + dx, npc.y + dy);
          if (c && (c.type === 'forge' || c.type === 'anvil')) { nearAnvil = true; break; }
      }
  }
  // Считаем реальную руду в рюкзаке (предметы с тегом iron_ore)
  let oreCount = 0;
  if (npc.inventory) {
      oreCount = npc.inventory.filter(i => i.tags && i.tags.includes('iron_ore')).length;
  }
  
  // Проверяем прочность кирки (если ее нет или она сломана)
  let hasPickaxe = npc.inventory && npc.inventory.find(i => i.tags && i.tags.includes('pickaxe'));
  let needsPickaxe = !hasPickaxe || (hasPickaxe.durability !== undefined && hasPickaxe.durability <= 0);

  // Куем только если есть 3 руды И нужна кирка
  if (nearAnvil && oreCount >= 3 && needsPickaxe) {
      actions.push({ type: 'craft_pickaxe', weight: 100 });
  }

  // РЫБАЛКА: Крафт удочки (зависит от дефицита еды, а не от личного голода)
  let hasFishingRod = npc.inventory && npc.inventory.find(i => i.tags && i.tags.includes('fishing'));
  let hasWoodForRod = npc.inventory && npc.inventory.filter(i => i.tags && i.tags.includes('wood')).length >= 2;
  let hasClothForRod = npc.inventory && npc.inventory.find(i => i.tags && (i.tags.includes('cloth') || i.tags.includes('bandage')));
  let aliveDwarves = state.npcs.filter(n => n.alive && !n.isCaravanTrader).length;
  let foodDeficit = Math.max(0, 1 - ((state.food || 0) / (aliveDwarves * 5 || 1)));

  if (!hasFishingRod && hasWoodForRod && hasClothForRod && foodDeficit > 0) {
      actions.push({ type: 'craft_fishing_rod', weight: 40 * (1 + foodDeficit) });
  }

  // КРАФТ ИЗ ОЧЕРЕДИ (приказы игрока)
  if (state.craftQueue && state.craftQueue.length > 0 && window.CRAFTABLES) {
    for (let _ci = 0; _ci < state.craftQueue.length; _ci++) {
      const _job = state.craftQueue[_ci];
      if (_job.count <= 0) continue;

      // БРОНИРОВАНИЕ: если все места заняты и это не наш claim — пропускаем
      if (!_job.claimedBy) _job.claimedBy = [];
      const _myClaim = _job.claimedBy.find(e => e.id === npc.id);
      if (!_myClaim && _job.claimedBy.length >= _job.count) continue;

      if (!window.canCraft || !window.canCraft(npc, _job.id)) continue;

      let _w = 100;
      if (npc.hunger > 70) _w -= (npc.hunger - 70) * 2;
      if (npc.thirst > 70) _w -= (npc.thirst - 70) * 2;
      if (npc.fatigue > 80) _w -= 40;
      if (npc.trait && npc.trait.id === 'lazy') _w -= 20;
      if (npc.trait && npc.trait.id === 'hardworking') _w += 30;

      if (_w > 0) {
        // Захватываем или обновляем claim
        if (_myClaim) { _myClaim.tick = state.tick; }
        else { _job.claimedBy.push({ id: npc.id, tick: state.tick }); }
        actions.push({ type: 'craft_job', weight: _w, job: _job });
      }
    }
  }

  // РЫБАЛКА: Вес действия (от дефицита еды в крепости, а не от личного голода)
  {
    const _fishRod = npc.inventory && npc.inventory.find(i => i.tags && i.tags.includes('fishing'));
    if (_fishRod) {
      const _aliveCrew = state.npcs.filter(n => n.alive && !n.isCaravanTrader).length;
      const _foodDeficit = Math.max(0, 1 - ((state.food || 0) / (_aliveCrew * 5 || 1)));
      const _desireFood = Math.pow(_foodDeficit, 1.5);

      // Ищем ближайшую воду с рыбой (радиус 15)
      let _waterTgt = null, _waterDist = 999;
      for (let _fx = -15; _fx <= 15; _fx++) {
        for (let _fy = -15; _fy <= 15; _fy++) {
          const _fd = Math.abs(_fx) + Math.abs(_fy);
          if (_fd === 0 || _fd >= _waterDist) continue;
          const _fc = getCell(npc.x + _fx, npc.y + _fy);
          if (_fc && _fc.type === 'water' && _fc.water && _fc.water.fishPopulation > 0) {
            _waterTgt = { x: npc.x + _fx, y: npc.y + _fy };
            _waterDist = _fd;
          }
        }
      }

      if (_waterTgt) {
        // Опасность: монстр в радиусе 3 — вес 0 (не пойдёт)
        let _danger = false;
        for (let _fx = -3; _fx <= 3 && !_danger; _fx++) {
          for (let _fy = -3; _fy <= 3; _fy++) {
            const _fc = getCell(npc.x + _fx, npc.y + _fy);
            if (_fc && _fc.monster) { _danger = true; break; }
          }
        }

        if (!_danger) {
          const _skill = (npc.skills && npc.skills.fishing) || 0;
          const _prox = 1 / (1 + _waterDist / 15);
          let _traitMod = 1.0;
          if (npc.trait && npc.trait.id === 'hardworking') _traitMod = 1.1;
          if (npc.trait && npc.trait.id === 'lazy') _traitMod = 0.8;
          const _weight = 30 * (_desireFood + _skill / 10) * _prox * _traitMod;
          if (_weight > 5) {
            actions.push({ type: 'fishing', weight: _weight, target: _waterTgt });
          }
        }
      }
    }
  }
  
  // Голод: приоритет еде из рюкзака, потом котел, потом поиск
  if (npc.hunger > 60) {
    const edibleInInv = npc.inventory && npc.inventory.some(i => i.tags && i.tags.includes('edible'));
    if (edibleInInv) {
      actions.push({ type: 'eat_item', weight: Math.pow(npc.hunger, 1.5) * 2 + 20 });
    } else if (state.food > 0) {
      actions.push({ type: 'eat', weight: Math.pow(npc.hunger, 1.5) * 2 });
    } else {
      actions.push({ type: 'forage', weight: Math.pow(npc.hunger, 1.5) * 2 });
      if (npc.hunger > 85) actions.push({ type: 'eat_corpse', weight: 150 });
      // КАННИБАЛИЗМ: только при диком голоде (>90)
      if (npc.hunger > 90) {
        let bodyNearby = false;
        for (let dx = -12; dx <= 12 && !bodyNearby; dx++) {
          for (let dy = -12; dy <= 12; dy++) {
            const c = getCell(npc.x + dx, npc.y + dy);
            if (c && c.dead_bodies && c.dead_bodies.length > 0) { bodyNearby = true; break; }
          }
        }
        if (bodyNearby) actions.push({ type: 'eat_dwarf_corpse', weight: 180 });
      }
    }
    // ГОЛОДНОЕ БЕЗУМИЕ
    if (npc.hunger > 90 && npc.emo && npc.emo.stress > 60 && Reg.madness) {
      actions.push({ type: 'madness', weight: 250 });
    }
  }

  // Новое: Драка за руду (если Жадность > 70 и кто-то рядом копает)
  if (npc.facets && npc.facets.greed > 70) {
    actions.push({ type: 'steal_ore', weight: 60 });
  }

  // Эмерджентное безумие
  if (npc.emo.stress > 80 && Reg.madness) {
    actions.push({ type: 'madness', weight: 200 });
  }
  
  // Сон: если устал или ранен
  let restWeight = (npc.fatigue * 2) + (npc.hp < 50 ? (100 - npc.hp) * 1.5 : 0);
  actions.push({ type: 'rest', weight: restWeight });

  // Общение: если социальная потребность высокая, идет к столу
  if (npc.socialNeed > 80) actions.push({ type: 'socialize', weight: npc.socialNeed * 2 });

  if (adjBarrel && npc.thirst > 40) {
      actions.push({ type: 'drink', weight: Math.pow(npc.thirst, 1.2) }); // Зависит только от жажды
  }
  // Пьем в таверне ТОЛЬКО если есть деньги. Иначе water_life.js заставит его идти к воде.
  if (npc.thirst > 50 && (npc.wallet || 0) >= 5) {
      actions.push({ type: 'drink_tavern', weight: Math.pow(npc.thirst, 1.5) * 2 });
  }
  // ГИГИЕНА: Если дварф грязный, он хочет помыться (чтобы раны не заразились)
  if (npc.dirt && npc.dirt > 40) {
      actions.push({ type: 'wash', weight: npc.dirt * 1.5 });
  }
  // ПРИКАЗЫ ИГРОКА (Эмерджентная логика)
  if (state.playerOrders && state.playerOrders.length > 0) {
    for (let i = 0; i < state.playerOrders.length; i++) {
      const ord = state.playerOrders[i];
      const dist = Math.abs(npc.x - ord.x) + Math.abs(npc.y - ord.y);
      
      // Приказ виден, если он в радиусе 20 клеток
      if (dist <= 20) {
        let baseWeight = 120; 
        
        // 1. ГОЛОД И ЖАЖДА (Если сильно голоден, приказ почти игнорируется)
        if (npc.hunger > 70) baseWeight -= (npc.hunger - 70) * 2;
        if (npc.thirst > 70) baseWeight -= (npc.thirst - 70) * 2;
        
        // 2. СТРЕСС И УСТАЛОСТЬ
        if (npc.emo && npc.emo.stress > 60) baseWeight -= 30;
        if (npc.fatigue > 80) baseWeight -= 40;
        
        // 3. ХАРАКТЕР
        if (npc.trait && npc.trait.id === 'lazy') baseWeight -= 20;
        if (npc.trait && npc.trait.id === 'hardworking') baseWeight += 30;
        
        // 4. НАВЫК (Опытный копатель быстрее согласится)
        if (ord.type === 'dig' && npc.skills && npc.skills.mining) baseWeight += npc.skills.mining * 2;

        // 5. БЕЗОПАСНОСТЬ (Если рядом монстр, игнорируем приказы, кроме атаки)
        let hasMonsterNearby = false;
        for(let dx=-2; dx<=2; dx++) for(let dy=-2; dy<=2; dy++) {
            const c = getCell(npc.x+dx, npc.y+dy);
            if(c && c.monster) hasMonsterNearby = true;
        }
        if (hasMonsterNearby && ord.type !== 'attack') baseWeight = 0;

        // Если итоговый вес положительный, добавляем действие
        if (baseWeight > 0) {
            if (ord.type === 'build') {
                const bData = window.BUILDINGS ? window.BUILDINGS[ord.buildType] : null;
                if (bData) {
                    let hasRes = true;
                    for (let res in bData.cost) {
                        const count = npc.inventory ? npc.inventory.filter(i => (i.id === res || (i.tags && i.tags.includes(res)))).length : 0;
                        if (count < bData.cost[res]) hasRes = false;
                    }
                    if (hasRes) {
                        if (npc.hunger > 70 || npc.thirst > 70) baseWeight = 50;
                        actions.push({ type: 'build', weight: baseWeight, order: ord });
                    }
                }
            } else {
                actions.push({ type: ord.type, weight: baseWeight, order: ord });
            }
        }
      }
    }
  }

  // Жрец не копает (но может делать всё остальное)
  if (!npc.isTempPriest) {
      // Проверяем, есть ли дерево рядом
      let nearbyTree = false;
      for (const [dx, dy] of [[0,1],[0,-1],[1,0],[-1,0]]) {
          const c = getCell(npc.x + dx, npc.y + dy);
          if (c && (c.type === 'tree' || c.type === 'tree_pine')) { nearbyTree = true; break; }
      }

      if (nearbyTree) {
          actions.push({ type: 'chop', weight: 80 }); // Высокий приоритет
      } else {
          // ФИЗИКА: С протезом-оружием копать невозможно
          let hasWeaponProsthetic = false;
          if (npc.body) {
              for (let part in npc.body) {
                  if (npc.body[part].status === 'prosthetic' && npc.body[part].prostheticType === 'weapon') {
                      hasWeaponProsthetic = true; break;
                  }
              }
          }
          if (!hasWeaponProsthetic) {
              actions.push({ type: 'dig', weight: 30 });
          }
      }
  }

  // ПОДБОР: если рядом лежат предметы — идём их брать
  let _nearItems = null;
  for (let _ddx = -5; _ddx <= 5 && !_nearItems; _ddx++) {
    for (let _ddy = -5; _ddy <= 5; _ddy++) {
      if (_ddx === 0 && _ddy === 0) continue;
      const _sc = getCell(npc.x + _ddx, npc.y + _ddy);
      if (_sc && _sc.items && _sc.items.length > 0) { _nearItems = { x: npc.x + _ddx, y: npc.y + _ddy }; break; }
    }
  }
  const _selfCell = getCell(npc.x, npc.y);
  if (_nearItems || (_selfCell && _selfCell.items && _selfCell.items.length > 0)) {
    actions.push({ type: 'haul', weight: 45 + (100 - (npc.fatigue || 0)) / 2 });
  }

  // КОСТЁР: дварф решает, пережечь ли бревно в уголь или сделать бинт
  let _nearFire = false;
  for (let _cdx = -2; _cdx <= 2 && !_nearFire; _cdx++) {
    for (let _cdy = -2; _cdy <= 2; _cdy++) {
      const _cc = getCell(npc.x + _cdx, npc.y + _cdy);
      if (_cc && _cc.type === 'campfire') { _nearFire = true; break; }
    }
  }
  if (_nearFire && npc.inventory) {
    const _hasWood = npc.inventory.some(i => i.tags && i.tags.includes('wood'));
    const _hasHerb = npc.inventory.some(i => i.tags && i.tags.includes('herb'));
    const _coalCount = npc.inventory.filter(i => i.tags && i.tags.includes('coal')).length;

    // Уголь нужен для кузни, но не в промышленных количествах
    if (_hasWood && _coalCount < 3) {
      const _hasOre = npc.inventory.some(i => i.tags && i.tags.includes('iron_ore'));
      const _needsFuel = _hasOre || (npc.inventory.some(i => i.tags && i.tags.includes('pickaxe')) === false);
      actions.push({ type: 'make_charcoal', weight: _needsFuel ? 70 : 25 });
    }

    // Бинт нужен, только если дварф ранен
    if (_hasHerb && npc.hp < npc.maxHp * 0.85) {
      const _hurt = npc.hp < npc.maxHp * 0.5;
      actions.push({ type: 'make_bandage', weight: _hurt ? 90 : 40 });
    }
  }

  for(let a of actions) {
    if (a.type === 'dig' && (npc.trait && (npc.trait && npc.trait.id)) === 'hardworking' && npc.inv.ore < 10) a.weight += 100;
    if (a.type === 'dig' && (npc.trait && (npc.trait && npc.trait.id)) === 'lazy') a.weight -= 20;
    if (a.type === 'rest' && (npc.trait && (npc.trait && npc.trait.id)) === 'lazy' && npc.fatigue > 20) a.weight += 50;
  }

  for (let stateId in npc.states) {
    const def = Reg.states[stateId];
    if (def && def.modifyWeight) {
      for (let a of actions) a.weight += def.modifyWeight(npc, a.type);
    }
  }

  actions.sort((a, b) => b.weight - a.weight);
  const bestAction = actions[0];

  if (bestAction.type === 'fight') {
    // Определяем цель: либо монстра рядом, либо по приказу
    let targetMob = hasMonster;
    if (!targetMob && bestAction.order) {
        const oc = getCell(bestAction.order.x, bestAction.order.y);
        if (oc && oc.monster) targetMob = oc.monster;
    }
    
    if (!targetMob) {
        // Монстр уже мертв или убежал
        if (bestAction.order) state.playerOrders = state.playerOrders.filter(o => o !== bestAction.order);
        npc.task = { type: 'idle', path: [] };
        return true;
    }

    const distToMob = Math.abs(npc.x - targetMob.x) + Math.abs(npc.y - targetMob.y);
    
    if (distToMob <= 1) {
        npc.task = { type: 'fight' };
        if (Reg.doCombat) {
          Reg.doCombat(npc, targetMob, state);
        } else {
          targetMob.hp -= 10;
          if (targetMob.hp <= 0) getCell(targetMob.x, targetMob.y).monster = null;
        }
    } else {
        // Идем к монстру (приказ)
        if (!npc.task.path || npc.task.path.length === 0) {
            const path = window.GameUtils.findPath(npc.x, npc.y, targetMob.x, targetMob.y, 'floor');
            if (path && path.length > 0) {
                npc.task = { type: 'move_to_wall', path: path }; // используем универсальный движок
            } else {
                npc.task = { type: 'idle', path: [] };
                if (bestAction.order) state.playerOrders = state.playerOrders.filter(o => o !== bestAction.order);
            }
        } else {
            const nextStep = npc.task.path.shift();
            if (nextStep) { npc.x = nextStep.x; npc.y = nextStep.y; }
        }
    }
    return true;
  }
  
  // Обработка эмерджентного безумия
  // ГОТОВКА НА КОСТРЕ
  if (bestAction.type === 'cook_meat') {
    // 1. ПРОВЕРКА: Есть ли у дварфа сырое мясо?
    let rawMeatIdx = -1;
    if (npc.inventory) {
        rawMeatIdx = npc.inventory.findIndex(i => i.tags && i.tags.includes('meat') && i.tags.includes('raw'));
    }
    if (rawMeatIdx === -1) { return false; }

    // 2. ИЩЕМ БЛИЖАЙШИЙ КОСТЕР (а не жестко зашитый -3,0)
    let adjFire = null;
    let targetFire = null;
    
    // Сначала проверяем, может он уже стоит рядом с костром
    for (const [dx, dy] of [[0,1],[0,-1],[1,0],[-1,0]]) {
      const c = getCell(npc.x + dx, npc.y + dy);
      if (c && c.type === 'campfire') { 
          adjFire = { x: npc.x + dx, y: npc.y + dy }; 
          break; 
      }
    }

    if (adjFire) {
      // Он рядом — готовим
      npc.inventory.splice(rawMeatIdx, 1); // Удаляем сырое мясо из рюкзака
      state.food += 2; // 1 мясо = 2 еды на общий склад // Сбалансировано: 1 мясо = 1 еда 
      Reg.log(`${npc.name} жарит мясо на костре. Запах разносится по шахте.`, 'sys');
      Reg.addMemory(npc, `Он приготовил мясо на костре.`, { type: 'joy', power: 15, category: 'cooking' });
      npc.emo.joy = Math.min(100, npc.emo.joy + 5);
      npc.task = { type: 'idle', path: [] };
      return true;
    } else {
      // Ищем любой костер на карте (в радиусе 20 клеток)
      let closestDist = 999;
      for (let k in state.cells) {
          if (state.cells[k].type === 'campfire') {
              const [cx, cy] = k.split(',').map(Number);
              const dist = Math.abs(npc.x - cx) + Math.abs(npc.y - cy);
              if (dist < closestDist && dist < 20) {
                  closestDist = dist;
                  targetFire = { x: cx, y: cy };
              }
          }
      }

      if (targetFire) {
          const path = window.GameUtils.findPath(npc.x, npc.y, targetFire.x, targetFire.y, 'campfire');
          if (path && path.length > 0) {
              npc.task = { type: 'go_to_cook', path };
          } else {
              npc.task = { type: 'wander', path: [] }; // Не смог найти путь
          }
          return true;
      } else {
          // Костра нет нигде рядом
          npc.task = { type: 'wander', path: [] };
          return true;
      }
    }
  }

  // МОЛИТВА (обработка)
  if (bestAction.type === 'pray') {
    let adjAltar = null;
    for (const [dx, dy] of [[0,1],[0,-1],[1,0],[-1,0]]) {
      const c = getCell(npc.x + dx, npc.y + dy);
      if (c && c.type === 'altar') { adjAltar = { x: npc.x + dx, y: npc.y + dy }; break; }
    }
    if (adjAltar) {
      npc.faithNeed = Math.max(0, npc.faithNeed - 40);
      npc.emo.stress = Math.max(0, npc.emo.stress - 30);
      npc.emo.joy = Math.min(100, npc.emo.joy + 10);
      Reg.log(`${npc.name} стоит на коленях перед алтарем. Он шепчет молитву.`, 'sys');
      Reg.addMemory(npc, `Он помолился у алтаря. На душе стало легче.`, { type: 'joy', power: 15, category: 'religion' });
      npc.task = { type: 'idle', path: [] };
      return true;
    } else {
      // Ищем ЛЮБОЙ алтарь на карте
      let targetAltar = null;
      let closestDist = 999;
      
      for (let k in state.cells) {
        if (state.cells[k].type === 'altar') {
          const [ax, ay] = k.split(',').map(Number);
          const dist = Math.abs(npc.x - ax) + Math.abs(npc.y - ay);
          if (dist < closestDist) {
            closestDist = dist;
            targetAltar = { x: ax, y: ay };
          }
        }
      }

      if (targetAltar) {
          // Ищем свободную клетку РЯДОМ с найденным алтарем
          let target = null;
          const dirs = [[0,1],[0,-1],[1,0],[-1,0]];
          for (let [dx, dy] of dirs) {
            const c = getCell(targetAltar.x + dx, targetAltar.y + dy);
            if (c && c.type === 'floor' && !state.npcs.find(n => n.alive && n.x === targetAltar.x + dx && n.y === targetAltar.y + dy)) {
              target = { x: targetAltar.x + dx, y: targetAltar.y + dy }; break;
            }
          }
          
          if (target) {
              const path = window.GameUtils.findPath(npc.x, npc.y, target.x, target.y, 'floor');
              if (path && path.length > 0) npc.task = { type: 'go_to_pray', path };
              else npc.task = { type: 'wander', path: [] };
          } else {
              npc.task = { type: 'wander', path: [] };
          }
      } else {
          npc.task = { type: 'wander', path: [] };
      }
      return true;
    }
  }

  // ПИТЬЕ В ТАВЕРНЕ
  if (bestAction.type === 'drink_tavern') {
    if (adjBarrel) {
      if (state.booze === undefined) state.booze = 20; // Инициализация
      if (state.booze <= 0) {
        Reg.log(`${npc.name} хочет выпить, но бочка пуста!`, 'death');
        npc.emo.stress = Math.min(100, npc.emo.stress + 15);
        npc.task = { type: 'idle', path: [] };
        return true;
      }

      if ((npc.wallet || 0) >= 5) {
        npc.wallet -= 5;
        // ФИЗИЧЕСКИ УДАЛЯЕМ БОЧКУ С КАРТЫ
        let barrelFound = false;
        for (let dx = -1; dx <= 1 && !barrelFound; dx++) {
            for (let dy = -1; dy <= 1 && !barrelFound; dy++) {
                const adj = getCell(npc.x + dx, npc.y + dy);
                if (adj && adj.type === 'beer_tap') {
                    adj.type = 'floor'; // Бочка выпита
                    barrelFound = true;
                }
            }
        }
      } else {
        Reg.log(`${npc.name} хочет выпить, но у него нет денег!`, 'sys');
        npc.task = { type: 'idle', path: [] };
        return true;
      }
      npc.emo.drunk = Math.min(100, (npc.emo.drunk || 0) + 30);
      npc.emo.stress = Math.max(0, npc.emo.stress - 40);
      // ФИЗИКА ВОДЫ
      const waterCell = getCell(npc.x, npc.y);
      if (waterCell && waterCell.water) {
          const w = waterCell.water;
          // 1. ТЕМПЕРАТУРА (горячая/ледяная вода обжигает)
          if (w.temperature > 40) { npc.hp -= 5; npc.emo.stress = Math.min(100, npc.emo.stress + 15); Reg.log(`${npc.name} обжигается о горячую воду!`, 'death'); }
          if (w.temperature < 5) { npc.hp -= 3; npc.emo.stress = Math.min(100, npc.emo.stress + 10); Reg.log(`${npc.name} пьет ледяную воду. Зубы ломит.`, 'sys'); }

          // 2. СОЛЕНОСТЬ (не утоляет жажду)
          if (w.salinity === 'salt') {
              npc.thirst = Math.max(0, npc.thirst - 20); // Плохо утоляет
              Reg.log(`${npc.name} пьет соленую воду. Жажда не проходит.`, 'sys');
          } else {
              npc.thirst = 0; // Утолил
          }

          // 3. ЧИСТОТА (инфекция)
          if (w.purity === 'infected' || w.purity === 'stagnant') {
              if (Math.random() < 0.4) {
                  npc.infections = npc.infections || [];
                  if (!npc.infections.includes('stomach')) npc.infections.push('stomach');
                  Reg.log(`${npc.name} пьет грязную воду. Внутри все горит.`, 'death');
              }
          }

          // 4. ГЛУБИНА (утопление, если глубоко)
          if (w.depth >= 3 && !npc.swims) {
              npc.hp -= 2;
              Reg.log(`${npc.name} барахтается в глубокой воде.`, 'combat');
              if (npc.hp <= 0) { if (window.killNpc) window.killNpc(npc, 'утонул'); return true; }
          }
      } else {
          npc.thirst = 0; // Если свойств нет (старая вода) — утоляет как раньше
      }
      Reg.log(`${npc.name} платит 5 золота и выпивает кружку эля.`, 'sys');
      // Дварф выпил, теперь генерируем мысль через композер
      const drinkThought = Reg.composer.generate(npc, 'beer_tap', 'drink');
      if (drinkThought) {
        Reg.addMemory(npc, drinkThought.text, drinkThought.emo);
      } else {
        Reg.addMemory(npc, "Он выпил эля.", { type: 'joy', power: 10, category: 'tavern' });
      }
      npc.task = { type: 'idle', path: [] };
      return true;
    } else {
      let target = { x: 3, y: 0 };
      const dirs = [[0,1],[0,-1],[1,0],[-1,0]];
      for (let [dx, dy] of dirs) {
        const c = getCell(3+dx, 0+dy);
        if (c && c.type === 'floor' && !state.npcs.find(n => n.alive && n.x === 3+dx && n.y === 0+dy)) {
          target = { x: 3+dx, y: 0+dy }; break;
        }
      }
      const path = window.GameUtils.findPath(npc.x, npc.y, target.x, target.y, 'floor');
      if (path && path.length > 0) {
          npc.task = { type: 'go_to_drink', path };
      } else {
          // Если путь не найден, не тупим, а идем копать
          npc.task = { type: 'dig', path: [] }; 
          npc.thirst = Math.max(0, npc.thirst - 10); // Чуть-чуть снижаем жажду, чтобы он не застрял навсегда
      }
      return true;
    }
  }

  // ЗАКУСКА
  if (bestAction.type === 'eat_snack') {
    if (adjSnack) {
      state.gold -= 2;
      npc.hunger = 0;
      npc.hp = Math.min(npc.maxHp, npc.hp + 10);
      Reg.log(`${npc.name} платит 2 золота за закуску.`, 'sys');
      npc.task = { type: 'idle', path: [] };
      return true;
    } else {
      let target = { x: 3, y: -1 };
      const dirs = [[0,1],[0,-1],[1,0],[-1,0]];
      for (let [dx, dy] of dirs) {
        const c = getCell(3+dx, -1+dy);
        if (c && c.type === 'floor' && !state.npcs.find(n => n.alive && n.x === 3+dx && n.y === -1+dy)) {
          target = { x: 3+dx, y: -1+dy }; break;
        }
      }
      const path = window.GameUtils.findPath(npc.x, npc.y, target.x, target.y, 'floor');
      if (path && path.length > 0) npc.task = { type: 'go_to_snack', path };
      else npc.task = { type: 'wander', path: [] };
      return true;
    }
  }

  if (bestAction.type === 'madness' && Reg.madness) {
    const madness = Reg.madness.getAction(npc, state);
    Reg.log(madness.text, 'death');
    Reg.addMemory(npc, madness.text, madness.emo);
    
    // КУЛДАУН: чтобы не сходил с ума каждую секунду
    npc.madnessCooldown = 200; 
    npc.emo.stress -= 20; // Немного успокаивается после приступа
    npc.task = { type: 'idle', path: [] };

    // Вместо мгновенной смерти, снимаем только 1 HP
    npc.hp -= 1; 
    if (npc.hp <= 0) killNpc(npc, 'умер от безумия'); 
    
    // Вызываем мысль о безумии только ОДИН раз
    if (!npc.hasGoneInsane) {
        npc.hasGoneInsane = true;
        Reg.addThought(npc, 'went_insane');
    }
    return true;
}

  if (bestAction.type === 'drink' && adjBarrel) {
    // 1. ПРОВЕРКА: есть ли эль?
    if (state.booze === undefined) state.booze = 20;
    if (state.booze <= 0) {
        // Эля нет, бочка пуста — превращаем в пол
        const c = getCell(adjBarrel.x, adjBarrel.y);
        if (c) c.type = 'floor';
        npc.task = { type: 'idle', path: [] };
        return true;
    }

    // 2. ПЬЕМ И УНИЧТОЖАЕМ БОЧКУ
    state.booze -= 1;
    const barrelCell = getCell(adjBarrel.x, adjBarrel.y);
    if (barrelCell) {
        barrelCell.type = 'floor'; // Бочка выпита и исчезает
        Reg.log(`[Таверна] Бочка опустела и исчезла.`, 'sys');
    }

    // 3. ЭФФЕКТЫ
    npc.emo.drunk = Math.min(100, (npc.emo.drunk || 0) + 30);
    npc.emo.stress = Math.max(0, (npc.emo.stress || 0) - 40);
    if (npc.longTerm) npc.longTerm.cirrhosis = (npc.longTerm.cirrhosis || 0) + 5;
    if (npc.longTerm) npc.longTerm.alcoholism = (npc.longTerm.alcoholism || 0) + 10;
    Reg.log(`${npc.name} отпивает из бочки. Его глаза стекленеют.`, 'sys');
    
    npc.task = { type: 'idle', path: [] };
    return true;
  }

  if (bestAction.type === 'dig' || bestAction.type === 'chop') {
    const order = bestAction.order;
    let adjWall = null;
    let adjTree = null;

    if (order) {
        // ЕСТЬ ПРИКАЗ: идем строго к нему
        if (Math.abs(npc.x - order.x) + Math.abs(npc.y - order.y) === 1) {
            const c = getCell(order.x, order.y);
            if (c && (c.type === 'stone' || c.type === 'ore' || c.type === 'coal_ore') && bestAction.type === 'dig') {
                adjWall = { x: order.x, y: order.y };
            } else if (c && (c.type === 'tree' || c.type === 'tree_pine') && bestAction.type === 'chop') {
                adjTree = { x: order.x, y: order.y };
            } else {
                // Приказ выполнен или цель изменилась (например, кто-то уже сломал стену)
                state.playerOrders = state.playerOrders.filter(o => o !== order);
                npc.task = { type: 'idle', path: [] };
                return true;
            }
        } else {
            // Не рядом. Прокладываем путь.
            if (!npc.task.path || npc.task.path.length === 0 || npc.task.ordX !== order.x || npc.task.ordY !== order.y) {
                const path = window.GameUtils.findPath(npc.x, npc.y, order.x, order.y, 'floor');
                if (path && path.length > 0) {
                    npc.task = { type: 'move_to_wall', path: path, ordX: order.x, ordY: order.y };
                } else {
                    // Путь заблокирован (стена замурована) — отменяем приказ
                    if (Math.abs(npc.x - order.x) + Math.abs(npc.y - order.y) > 1) {
                        Reg.log(`[Приказ] Путь к (${order.x}, ${order.y}) заблокирован. Отмена.`, 'sys');
                        state.playerOrders = state.playerOrders.filter(o => o !== order);
                    }
                    npc.task = { type: 'idle', path: [] };
                }
            } else {
                 // Двигаемся по уже проложенному пути
                 const nextStep = npc.task.path.shift();
                 if (nextStep) { npc.x = nextStep.x; npc.y = nextStep.y; }
            }
            return true; // Выходим, чтобы не запускать старый поиск BFS
        }
    } else {
        // СТАРАЯ ЛОГИКА: если приказа нет, ищем ближайшую стену/дерево
        for (const [dx, dy] of [[0,1],[0,-1],[1,0],[-1,0]]) {
          const c = getCell(npc.x + dx, npc.y + dy);
          if (c && (c.type === 'stone' || c.type === 'ore' || c.type === 'coal_ore')) { adjWall = { x: npc.x + dx, y: npc.y + dy }; break; }
        }
        for (const [dx, dy] of [[0,1],[0,-1],[1,0],[-1,0]]) {
          const c = getCell(npc.x + dx, npc.y + dy);
          if (c && (c.type === 'tree' || c.type === 'tree_pine')) { adjTree = { x: npc.x + dx, y: npc.y + dy }; break; }
        }
    }

    if (adjTree) {
      npc.task = { type: 'chop', path: [] };
      const cell = getCell(adjTree.x, adjTree.y);
      cell.treeHp = (cell.treeHp || 15);
      
      // Проверяем топор
      const axe = npc.inventory && npc.inventory.find(i => i.tags && i.tags.includes('axe'));
      let damage = 1; 
      let toolName = 'голыми руками';
      
      if (axe) {
          // ФИЗИКА: Урон от топора (масса * острота / 2)
          damage = Math.max(2, Math.floor(((axe.mass || 5) * (axe.sharpness || 3)) / 4));
          toolName = axe.name;
          axe.durability -= 1;
          if (axe.durability <= 0) {
              Reg.log(`[ПОЛОМКА] ${axe.name} ${npc.name} сломался о ствол!`, 'combat');
              npc.inventory = npc.inventory.filter(i => i !== axe);
              if (Reg.fire) Reg.fire('item_broken', npc, axe);
          }
          // Логируем удар топором (с вероятностью, чтобы не спамить)
          if (Math.random() < 0.5) {
              Reg.log(Reg.generateChopText(npc, true), 'sys');
          }
      } else {
          // Без топора: разбивает руки
          npc.hp -= 2; 
          Reg.log(Reg.generateChopText(npc, false), 'sys');
      }
      
      cell.treeHp -= damage;
      
      // ДЕРЕВО ПАДАЕТ
      if (cell.treeHp <= 0) {
          cell.type = 'floor';
          const woodCount = 3 + Math.floor(Math.random() * 3); // 3-5 бревен
          if (!cell.items) cell.items = [];
          for (let i = 0; i < woodCount; i++) {
              let newWood;
              if (typeof window.createItem === 'function') {
                  newWood = window.createItem('wood');
              } else {
                  newWood = { name: 'Бревно', type: 'resource', tags: ['wood', 'fuel'], file: '🪵', isEmoji: true, mass: 8, hardness: 3 };
              }
              cell.items.push(newWood);
          }
          let fallText = 'Дерево падает!';
          try {
              if (Reg.generateTreeFallText) fallText = Reg.generateTreeFallText(npc);
          } catch(e) {}
          Reg.log(`${fallText} ${woodCount} бревен падает на пол.`, 'good');
          Reg.fire('tree_chopped', cell, npc, state);
      }
      return true;
    }

    if (adjWall) {
      npc.task = { type: 'dig', path: [] };
      const cell = getCell(adjWall.x, adjWall.y);
      const wasOre = cell.type === 'ore';
      const wasCoal = cell.type === 'coal_ore';
      cell.type = 'floor';
      
      // ИЗНОС КИРКИ
      const pickObj = npc.inventory && npc.inventory.find(i => i.tags && i.tags.includes('pickaxe'));
      if (pickObj && pickObj.durability > 0) {
          pickObj.durability -= 1;
          if (pickObj.durability <= 0) {
              Reg.log(`[ПОЛОМКА] Кирка ${npc.name} сломалась от долгой работы!`, 'combat');
              // Превращаем кирку в металлолом
              pickObj.name = 'Кусок железа';
              pickObj.tags = ['scrap', 'metal'];
              pickObj.isEmoji = false;
              pickObj.file = 'assets/icons/53 question trap.png';
              pickObj.mass = 2;
              pickObj.durability = undefined;
              if (Reg.fire) Reg.fire('item_broken', npc, pickObj);
          }
      }
      // ВЫЗЫВАЕМ СОБЫТИЕ: Игрок копнул камень!
      Reg.fire('tile_dug', cell, npc, state);
      
