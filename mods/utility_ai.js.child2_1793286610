  const targets = { 
    eat: { x: 0, y: -1, cellType: 'pot' }, 
    deposit: { x: 0, y: 1, cellType: 'storage' }, 
    rest: { x: -1, y: 0, cellType: 'bed' },
    socialize: { x: -1, y: -1, cellType: 'table' }
  };
  const t = targets[bestAction.type];
  if (!t) { npc.task = { type: "idle", path: [] }; return true; }
  const dist = Math.abs(npc.x - t.x) + Math.abs(npc.y - t.y);

  if (dist <= 1) {
    if (bestAction.type === 'eat') { 
      if (state.food > 0) { state.food--; npc.hunger = 0; npc.hp = Math.min(npc.maxHp, npc.hp + 20); } 
      npc.task = { type: 'idle', path: [] }; return true; 
    }
    // ОБРАБОТКА КРАФТА КИРКИ
  if (bestAction.type === 'craft_pickaxe') {
      // Удаляем 3 руды из массива рюкзака
      let removed = 0;
      if (npc.inventory) {
          npc.inventory = npc.inventory.filter(item => {
              if (removed < 3 && item.tags && item.tags.includes('iron_ore')) {
                  removed++;
                  return false; // удаляем
              }
              return true;
          });
      }
      
      if (!npc.inventory) npc.inventory = [];
      if (!npc.inventory.find(i => i.tags && i.tags.includes('pickaxe'))) {
          let _newPick = (typeof window.createItem === 'function') ? window.createItem('pickaxe') : { name: 'Железная кирка', type: 'tool', tags: ['tool', 'pickaxe', 'metal', 'weapon'], file: '⛏️', isEmoji: true, mass: 5, hardness: 8, durability: 100, dmgMod: 5 };
      npc.inventory.push(_newPick);
      }
      npc.broken_pickaxe_logged = false;
      
      Reg.log(`[Кузня] ${npc.name} выковал новую кирку на наковальне.`, 'good');
      Reg.addMemory(npc, `Я выковал кирку. Теперь можно копать.`, { type: 'joy', power: 15, category: 'craft' });
      
      npc.task = { type: 'idle', path: [] };
      return true;
  }

  if (bestAction.type === 'deposit') { 
      // ВЫВАЛИВАЕМ РУДУ ИЗ РЮКЗАКА НА СКЛАД
      if (npc.inventory) {
          const oreItems = npc.inventory.filter(i => i.tags && i.tags.includes('iron_ore'));
          if (oreItems.length > 0) {
              const c = getCell(t.x, t.y);
              if (!c.items) c.items = [];
              
              // Оставляем 3 руды, если кирка сломана (нужно на крафт)
              let hasPickaxe = npc.inventory.find(i => i.tags && i.tags.includes('pickaxe'));
              let needsPickaxe = !hasPickaxe || (hasPickaxe.durability !== undefined && hasPickaxe.durability <= 0);
              
              let oreToDeposit = [...oreItems];
              if (needsPickaxe && oreToDeposit.length >= 3) {
                  oreToDeposit.splice(0, 3); // Оставляем 3
              } else if (needsPickaxe) {
                  oreToDeposit = []; // Оставляем все, если их меньше 3
              }
              
              if (oreToDeposit.length > 0) {
                  oreToDeposit.forEach(item => c.items.push(item));
                  oreToDeposit.forEach(item => {
                      const idx = npc.inventory.indexOf(item);
                      if (idx !== -1) npc.inventory.splice(idx, 1);
                  });
                  Reg.log(`[Склад] ${npc.name} сдал ${oreToDeposit.length} руды на склад.`, 'good');
              } else if (needsPickaxe) {
                  Reg.log(`[Склад] ${npc.name} оставляет руду для крафта новой кирки.`, 'sys');
              }
          }
      }
      npc.task = { type: 'idle', path: [] }; return true; 
    }
    if (bestAction.type === 'rest') { 
      npc.hp = Math.min(npc.maxHp, npc.hp + 15); 
      npc.fatigue = Math.max(0, npc.fatigue - 20); // Восстанавливаем усталость
      npc.task = { type: 'rest', path: [] }; return true; 
    }
    if (bestAction.type === 'socialize') {
      npc.socialNeed = Math.max(0, npc.socialNeed - 30);
      npc.emo.stress = Math.max(0, npc.emo.stress - 15);
      npc.emo.joy = Math.min(100, npc.emo.joy + 10);
      if (Math.random() < 0.2) Reg.log(`${npc.name} сидит за столом и отдыхает в компании.`, 'sys');
      npc.task = { type: 'socialize', path: [] }; return true;
    }
  }

  // === РЫБАЛКА ===
  if (bestAction.type === 'fishing') {
    const _t = bestAction.target;
    if (!_t) { npc.task = { type: 'idle', path: [] }; return true; }
    const _dist = Math.abs(npc.x - _t.x) + Math.abs(npc.y - _t.y);

    if (_dist > 1) {
      if (npc.task.type !== 'go_to_fishing' || !npc.task.path || npc.task.path.length === 0) {
        const _path = window.GameUtils.findPath(npc.x, npc.y, _t.x, _t.y, 'floor');
        if (_path && _path.length > 0) npc.task = { type: 'go_to_fishing', path: _path, target: _t };
        else npc.task = { type: 'idle', path: [] };
      }
      return true;
    }

    // Уже у воды
    const _cell = getCell(_t.x, _t.y);
    if (!_cell || _cell.type !== 'water' || !_cell.water) { npc.task = { type: 'idle', path: [] }; return true; }

    const _rod = npc.inventory && npc.inventory.find(i => i.tags && i.tags.includes('fishing'));
    if (!_rod) { npc.task = { type: 'idle', path: [] }; return true; }

    // Износ
    _rod.durability = (_rod.durability || 0) - 1;
    if (_rod.durability <= 0) {
      npc.inventory = npc.inventory.filter(i => i !== _rod);
      Reg.log(npc.name + ' сломал удочку.', 'combat');
      if (Reg.fire) Reg.fire('item_broken', npc, _rod);
      npc.task = { type: 'idle', path: [] };
      return true;
    }

    // Шанс улова (по свойствам)
    const _skill = (npc.skills && npc.skills.fishing) || 0;
    const _w = _cell.water;
    let _rodBonus = 0;
    if (_rod.quality === 'masterwork') _rodBonus = 15;
    else if (_rod.quality === 'exceptional') _rodBonus = 10;
    else if (_rod.quality === 'superior') _rodBonus = 5;
    else if (_rod.quality === 'shoddy') _rodBonus = -10;
    else if (_rod.quality === 'broken') _rodBonus = -20;

    const _depthPenalty = ((_w.depth || 1) - 1) * 10;
    let _chance = 30 + _skill * 5 + _rodBonus - _depthPenalty;
    if (_w.fishPopulation <= 0) _chance = 0;

    const _roll = Math.random() * 100;
    let _result = 'miss';

    if (_roll < _chance) {
      _result = 'catch';
      _w.fishPopulation = Math.max(0, _w.fishPopulation - 1);
      const _fish = (typeof window.createItem === 'function') ? window.createItem('fish') : { name: 'Рыба', tags: ['fish', 'raw', 'edible'], calories: 25 };
      if (!npc.inventory) npc.inventory = [];
      npc.inventory.push(_fish);
      npc.skills.fishing = (npc.skills.fishing || 0) + 0.5;
    } else if (_roll < _chance + 20) {
      _result = 'junk';
    }

    // Атомарный текст
    let _text = '';
    if (Reg.generateFishingText) {
      _text = Reg.generateFishingText(npc, _result, _w.fishType);
    } else {
      _text = npc.name + (_result === 'catch' ? ' поймал рыбу.' : ' ничего не поймал.');
    }
    Reg.log(_text, _result === 'catch' ? 'good' : 'sys');

    if (_result === 'catch') Reg.addMemory(npc, 'Хороший улов. Рыба бьётся в руках.', { type: 'joy', power: 10, category: 'fishing' });
    else if (_result === 'miss') Reg.addMemory(npc, 'Рыба не клюёт.', { type: 'sadness', power: 3, category: 'fishing' });

    npc.task = { type: 'idle', path: [] };
    return true;
  }

  if (npc.task.type !== 'go_to_' + bestAction.type || !npc.task.path || npc.task.path.length === 0) {
    const path = window.GameUtils.findPath(npc.x, npc.y, t.x, t.y, t.cellType);
    if (path && path.length > 0) npc.task = { type: 'go_to_' + bestAction.type, path };
    else { npc.task = { type: 'wander', path: [] }; return true; }
  }

  if (npc.task.path && npc.task.path.length > 0) {
    const nextStep = npc.task.path.shift();
    if (!state.npcs.find(n => n.alive && n.x === nextStep.x && n.y === nextStep.y)) {
      npc.x = nextStep.x; npc.y = nextStep.y;
    } else npc.task.path = []; 
  }
  return true;
});
