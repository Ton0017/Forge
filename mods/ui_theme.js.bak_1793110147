(function(){
  setTimeout(() => {
    const style = document.createElement('style');
    style.innerHTML = `
      /* 1. ШРИФТ (Книжный) */
      * {
        font-family: Georgia, 'Times New Roman', serif !important;
      }

      /* 2. ПАНЕЛИ И МОДАЛКИ (Дерево + Железо + Скролл) */
      .panel, .df-modal, #df-character-modal, #panel-crew, #panel-trade, #panel-craft, #bestiary-modal, #mob-modal, #debug-modal, #df-modal {
        background-color: #1a1008 !important;
        background-image: repeating-linear-gradient(45deg, rgba(0,0,0,0.2) 0px, rgba(0,0,0,0.2) 2px, transparent 2px, transparent 4px) !important;
        border: 4px double #5a4a3a !important;
        color: #d4c4a8 !important;
        box-shadow: inset 0 0 15px #000, 0 5px 15px rgba(0,0,0,0.8) !important;
        border-radius: 0 !important;
        /* Починили скролл: применяем к самому окну */
        max-height: 85vh !important;
        overflow-y: auto !important;
      }

      /* 3. КНОПКИ (Камень + Медь) */
      button, .btn, .build-btn, #hire-priest-btn {
        background: #2a1e14 !important;
        border: 2px solid #5a4a3a !important;
        color: #c87b32 !important;
        text-transform: uppercase !important;
        font-weight: bold !important;
        letter-spacing: 1px !important;
        border-radius: 0 !important;
        padding: 6px !important;
        cursor: pointer !important;
        box-shadow: inset 1px 1px 0 rgba(255,255,255,0.1), inset -1px -1px 0 #000 !important;
      }
      button:hover, .build-btn:hover, #hire-priest-btn:hover {
        background: #3a2a1e !important;
        color: #e0a040 !important;
      }
      button:active {
        box-shadow: inset -1px -1px 0 rgba(255,255,255,0.1), inset 1px 1px 0 #000 !important;
      }

      /* 4. ВКЛАДКИ (Свитки) */
      .tab-btn, .df-main-tab, .df-sub-tab {
        background: #1a1008 !important;
        border: 1px solid #3a2a1e !important;
        color: #7a6b4a !important;
      }
      .tab-btn.active, .df-main-tab.active, .df-sub-tab.active {
        background: #2a1e14 !important;
        color: #c87b32 !important;
        border-bottom: 2px solid #c87b32 !important;
      }

      /* 5. СКРОЛЛБАР (Железный) */
      ::-webkit-scrollbar { width: 10px !important; }
      ::-webkit-scrollbar-track { background: #111 !important; }
      ::-webkit-scrollbar-thumb { background: #5a4a3a !important; border: 1px solid #222 !important; }
    `;
    document.head.appendChild(style);
    console.log('[UI Theme] Стили "Железо и Книга" применены ко всему интерфейсу.');

    // ЖЕЛЕЗОБЕТОННАЯ ЗАЩИТА: при старте мира полностью скрываем меню
    Reg.on('world_init', () => {
      const el = document.getElementById('menu-overlay');
      if (el) {
          el.classList.add('hidden');
          el.style.display = 'none';
      }
    });
  }, 500);
})();

// ПОДНИМАЕМ ГЛАВНОЕ МЕНЮ НАД ВСЕМИ МОДАЛКАМИ
setTimeout(() => {
    const style = document.createElement('style');
    style.innerHTML = `
        #menu-overlay {
            z-index: 999999999 !important; /* Выше всех */
        }
        /* Скрываем кнопки и модалки, пока открыто меню */
        /* Правило скрытия модалок удалено */
    `;
    document.head.appendChild(style);
}, 1000);

// ЗАЩИТА ОТ ПЕРЕКРЫТИЯ МОДАЛОК
setTimeout(() => {
    const style = document.createElement('style');
    style.innerHTML = `
        #df-character-modal {
            z-index: 9999999 !important; /* Карточка всегда выше кнопок */
        }
