  // === 2. МОДИФИКАТОРЫ КАЧЕСТВА (Шансы и проценты) ===
  window.QUALITY_TIERS = {
    masterwork:   { name: 'Шедевр',         critBonus: 0.30, sharpnessMult: 1.5,  integrityMult: 2.0, beauty: 100, priceMult: 3.0, color: '#ffcc00' },
    exceptional:  { name: 'Исключительное', critBonus: 0.15, sharpnessMult: 1.3,  integrityMult: 1.5, beauty: 70,  priceMult: 2.0, color: '#c87b32' },
    superior:     { name: 'Превосходное',   critBonus: 0.05, sharpnessMult: 1.15, integrityMult: 1.2, beauty: 50,  priceMult: 1.5, color: '#a09070' },
    fine:         { name: 'Хорошее',        critBonus: 0.00, sharpnessMult: 1.0,  integrityMult: 1.0, beauty: 30,  priceMult: 1.0, color: '#e0d8c8' },
    ordinary:     { name: 'Обычное',        critBonus: -0.05,sharpnessMult: 0.9,  integrityMult: 0.8, beauty: 10,  priceMult: 0.8, color: '#c8c8b8' },
    shoddy:       { name: 'Плохое',         critBonus: -0.15,sharpnessMult: 0.7,  integrityMult: 0.6, beauty: 5,   priceMult: 0.5, color: '#a83838' },
    broken:       { name: 'Бракованное',    critBonus: -0.30,sharpnessMult: 0.5,  integrityMult: 0.4, beauty: 0,   priceMult: 0.2, color: '#5a3a3a' }
  };

  // === 3. ФУНКЦИЯ СОЗДАНИЯ ПРЕДМЕТА (С качеством) ===
  window.createItem = function(id, qualityTier) {
      const template = window.ITEM_DATA[id];
      if (!template) return null;
      
      // Если качество не задано — "Хорошее" (обычный предмет)
      const q = window.QUALITY_TIERS[qualityTier || 'fine'];
      
      let item = {
          id: id,
          name: template.name,
          type: template.type,
          tags: [...template.tags],
          file: template.sprite || template.emoji,
          isEmoji: !template.sprite,
          mass: template.mass,
          hardness: template.hardness,
          sharpness: template.sharpness,
          coverage: template.coverage,
          flexibility: template.flexibility,
          integrity: template.integrity,
          durability: template.durability,
          calories: template.calories,
          poisonChance: template.poisonChance,
          stopBleedChance: template.stopBleedChance,
          material: template.material,
          quality: qualityTier || 'fine',
          qualityName: q.name,
          qualityColor: q.color,
          critBonus: q.critBonus,
          beauty: q.beauty,
          priceMult: q.priceMult
      };

      // ПРИМЕНЯЕМ КАЧЕСТВО (только к оружию, броне, инструментам)
      if (template.type === 'weapon' || template.type === 'tool') {
          item.sharpness = Math.round((item.sharpness || 0) * q.sharpnessMult * 10) / 10;
          item.integrity = Math.round((item.integrity || 100) * q.integrityMult);
      }
      if (template.type === 'armor') {
          item.integrity = Math.round((item.integrity || 100) * q.integrityMult);
          // Качество брони влияет на шанс блокировки
          item.blockChance = (item.coverage || 0.5) * q.sharpnessMult;
      }

      return item;
  };

  // === 4. ГЕНЕРАТОР КАЧЕСТВА ПРИ КРАФТЕ (Зависит от навыка кузнеца) ===
  window.rollQuality = function(craftingSkill) {
      const skill = craftingSkill || 0;
      const roll = Math.random() * 100;
      
      // Опытный кузнец (навык 10) чаще делает шедевры
      if (roll < 1 + skill) return 'masterwork';
      if (roll < 6 + skill * 2) return 'exceptional';
      if (roll < 16 + skill * 3) return 'superior';
      if (roll < 50 + skill * 2) return 'fine';
      if (roll < 80) return 'ordinary';
      if (roll < 95) return 'shoddy';
      return 'broken';
  };

  console.log('[Data Items] База предметов с качеством загружена.');
